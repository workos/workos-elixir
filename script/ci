#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

# CI sets MIX_ENV=test for every job (see .github/workflows/{main,lint}.yml).
# Compiling in dev here would skip test/support and miss warnings CI catches.
export MIX_ENV=test

echo "==> Fetching dependencies..."
mix deps.get

echo "==> Compiling (warnings as errors)..."
mix compile --warnings-as-errors

echo "==> Checking formatting..."
mix format --check-formatted

echo "==> credo (lint)..."
# Must match lint.yml — --strict enables the low-priority design and
# readability checks that plain --all skips, and CI fails on them.
mix credo --strict -a

echo "==> dialyzer (typecheck)..."
mix dialyzer

echo "==> Running tests..."
mix test

# Each workload identity provider package is its own Mix project with its own
# release, so each has to pass on its own. Dialyzer is not run on them: they
# are one small module each and carry no dialyxir dependency.
for package in workload_identity_*/; do
  package="${package%/}"
  (
    cd "$package"

    echo "==> ${package}: fetching dependencies..."
    mix deps.get

    echo "==> ${package}: compiling (warnings as errors)..."
    mix compile --warnings-as-errors

    echo "==> ${package}: checking formatting..."
    mix format --check-formatted

    echo "==> ${package}: credo (lint)..."
    mix credo --strict -a

    echo "==> ${package}: running tests..."
    mix test
  )
done

echo "==> All checks passed."
